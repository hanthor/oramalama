# Managed by oramalama/opencode-rl — do not edit by hand.
# Regenerate with: ramalama serve --generate quadlet ... (see opencode-rl)

[Unit]
Description=RamaLama Gemma 4 31B AI Model Service
# Start after filesystems are mounted so the model blob paths are accessible.
After=local-fs.target

[Container]
AddDevice=-/dev/accel
AddDevice=-/dev/dri
AddDevice=-/dev/kfd
Image=docker.io/kyuz0/amd-strix-halo-toolboxes:vulkan-radv
RunInit=true
Environment=HOME=/tmp
Environment=HIP_VISIBLE_DEVICES=0
# ramalama emits --no-jinja by default; --jinja (appended via runtime-args) overrides it.
# Gemma 4 requires full Jinja2 template support or llama-server exits immediately.
# 128K context uses ~10GB KV cache on 96GB VRAM — 68GB headroom. OOM kills were
# CPU RAM exhaustion (31GB), not VRAM. Model lives entirely in the 96GB VRAM pool.
Exec=llama-server --host 0.0.0.0 --port 8080 \
     --model /mnt/models/gemma-4-31B-it-Q4_K_M.gguf \
     --no-jinja --no-warmup \
     --alias unsloth/gemma-4-31B-it-GGUF \
     --ctx-size 131072 --temp 0.8 \
     -ngl 999 --threads 16 --log-colors on \
     --jinja --parallel 1 --cache-ram 0
SecurityLabelDisable=true
DropCapability=all
NoNewPrivileges=true
Mount=type=bind,src=/var/home/james/.local/share/ramalama/store/huggingface/unsloth/gemma-4-31B-it-GGUF/blobs/sha256-2dfbfc7d538912f4ea11d29d85b4e25d7bc26386e53f57529f1d707c28b5828c,target=/mnt/models/chat_template_extracted,ro,Z
Mount=type=bind,src=/var/home/james/.local/share/ramalama/store/huggingface/unsloth/gemma-4-31B-it-GGUF/blobs/sha256-30ac8fa6b6fe8e23f73b2202b401ba352949674fe3a2d50c5c55bc88be76c809,target=/mnt/models/gemma-4-31B-it-Q4_K_M.gguf,ro,Z
ContainerName=oramalama
PublishPort=0.0.0.0:8080:8080

[Service]
# Restart on crash (including OOM kill). 30s delay lets the GPU driver settle.
Restart=on-failure
RestartSec=30
# Negative OOMScoreAdjust makes the kernel less likely to pick llama-server
# as an OOM victim. Without this, it gets killed every time — observed on
# Apr 02, Apr 03, Apr 06 across multiple sessions.
OOMScoreAdjust=-300

[Install]
# Start automatically when the user session starts (login / boot with lingering).
WantedBy=default.target
