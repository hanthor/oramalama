#!/bin/bash
#
# oramalama — local AI coding assistant powered by RamaLama
# https://github.com/containers/ramalama
#
# Subcommands: run  serve  launch  list  pull  ps  rm  search
# Global flags: --remote <url>  --model <name>  --dry-run

# ---------------------------------------------------------------------------
# Configuration defaults
# ---------------------------------------------------------------------------
CONTAINER_NAME="ramalama-opencode"
LOCAL_HOST="127.0.0.1"
LOCAL_PORT="8080"
OPENCODE_CONFIG="${HOME}/.config/opencode/opencode.json"
GOOSE_CONFIG="${HOME}/.config/goose/config.yaml"

# Default model: Gemma 4 31B (dense, best coding quality) at Q4_K_M quant (~18GB)
DEFAULT_MODEL="hf://unsloth/gemma-4-31B-it-GGUF:Q4_K_M"

# Systemd quadlet service name for the default model (persistent, auto-restart).
# Other models still use ad-hoc ramalama serve.
QUADLET_SERVICE="ramalama-opencode.service"

# ---------------------------------------------------------------------------
# User config file: ~/.config/oramalama/config
# Loaded before CLI flags so flags always win. Supported keys (bash syntax):
#   RAMALAMA_ENDPOINT=http://myserver:8080
#   DEFAULT_TOOL=opencode
#   DEFAULT_MODEL=hf://unsloth/gemma-4-31B-it-GGUF:Q4_K_M
# ---------------------------------------------------------------------------
USER_CONFIG="${HOME}/.config/oramalama/config"
# shellcheck source=/dev/null
[ -f "$USER_CONFIG" ] && source "$USER_CONFIG"

# ---------------------------------------------------------------------------
# check_deps: verify required tools are installed; exit with friendly hints
# if any are missing. llmfit is optional — silently tolerated here.
# ---------------------------------------------------------------------------
check_deps() {
    local missing=()
    for dep in ramalama gum jq curl; do
        command -v "$dep" &>/dev/null || missing+=("$dep")
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo "❌ Missing required dependencies:"
        for dep in "${missing[@]}"; do
            case "$dep" in
                ramalama) echo "   ramalama  → https://github.com/containers/ramalama" ;;
                gum)      echo "   gum       → https://github.com/charmbracelet/gum" ;;
                jq)       echo "   jq        → https://jqlang.github.io/jq/download/" ;;
                curl)     echo "   curl      → install via your system package manager" ;;
            esac
        done
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# detect_hardware: set USE_IMAGE and EXTRA_SERVE_FLAGS based on local GPU.
#
# Strix Halo (AMD Ryzen AI Max / RDNA 4) is an APU where the BIOS carves out
# a large chunk of system RAM as GPU VRAM (typically >60 GB). No discrete GPU
# currently ships with >60 GB VRAM, so this is a reliable heuristic.
#
# For all other hardware ramalama picks its own optimised image automatically
# (CUDA for NVIDIA, ROCm for standard AMD dGPUs, CPU fallback, etc.), so we
# just leave USE_IMAGE empty and let ramalama decide.
# ---------------------------------------------------------------------------
detect_hardware() {
    USE_IMAGE=""          # empty = let ramalama choose the container image
    EXTRA_SERVE_FLAGS="--jinja"
    IS_STRIX_HALO=false

    for card in /sys/class/drm/card*/device; do
        local vendor_path="${card}/vendor"
        local vram_path="${card}/mem_info_vram_total"
        if [[ -f "$vendor_path" && -f "$vram_path" ]]; then
            local vendor vram_bytes vram_gb
            vendor=$(cat "$vendor_path" 2>/dev/null)
            vram_bytes=$(cat "$vram_path" 2>/dev/null)
            vram_gb=$(( vram_bytes / 1024 / 1024 / 1024 ))
            # AMD vendor (0x1002) + >60 GB unified pool = Strix Halo APU
            if [[ "$vendor" == "0x1002" && "$vram_gb" -gt 60 ]]; then
                IS_STRIX_HALO=true
                USE_IMAGE="docker.io/kyuz0/amd-strix-halo-toolboxes:vulkan-radv"
                # Strix Halo has ~31 GB system RAM shared with the OS.
                # Limit parallelism and disable prompt cache to prevent OOM kills.
                EXTRA_SERVE_FLAGS="--jinja --parallel 1 --cache-ram 0"
                return
            fi
        fi
    done
}

# Strix Halo has ~113GB GPU pool but only ~31GB system RAM. KV cache lives on
# GPU (fine), but host-side compute buffers and the process RSS live in system
# RAM. Larger models leave less headroom for KV even on GPU, so we scale down.
#   ~2B  / ~4B  → full 262K (model tiny, lots of room)
#   ~7B  / ~8B  → 128K
#   ~14B / ~13B → 64K
#   ~27B / ~31B / ~34B → 32K  (e.g. Gemma 4 31B: 18GB model + ~4GB KV = 22GB)
#   ~70B / ~72B → 32K  (model alone ~40GB, leave room for KV)
#   ~122B / MoE giants → 16K  (model ~72GB, tight even on GPU)
# Patterns use [-/_] separators to avoid e.g. *1B* matching "31B".
# ---------------------------------------------------------------------------
get_ctx_size() {
    local model="$1"
    case "$model" in
        # MoE / very large — check active-param tags first
        *A10B*|*A14B*|*A4B*|*122B*|*123B*|*110B*)           echo  16384 ;;
        # ~70B dense
        *[-/_]70B*|*[-/_]72B*|*[-/_]65B*)                   echo  32768 ;;
        # ~27–34B dense (includes Gemma 4 31B)
        *[-/_]27B*|*[-/_]30B*|*[-/_]31B*|*[-/_]32B*|*[-/_]34B*)  echo  32768 ;;
        # ~12–14B
        *[-/_]12B*|*[-/_]13B*|*[-/_]14B*)                   echo  65536 ;;
        # ~7–8B and small multimodal (E4B)
        *[-/_]7B*|*[-/_]8B*|*E4B*|*[-/_]4B*)                echo 131072 ;;
        # ≤3B and small multimodal (E2B)
        *E2B*|*[-/_]1B*|*[-/_]2B*|*[-/_]3B*)                echo 262144 ;;
        # Unknown — conservative default
        *)                                                    echo  32768 ;;
    esac
}

# ============================================================================
# SHARED HELPERS
# ============================================================================

# Echo action but skip execution in dry-run mode
dry_run_cmd() {
    if $DRY_RUN; then
        echo "[dry-run] $*"
    else
        eval "$@"
    fi
}

# Run commands locally or via SSH
run_cmd() {
    if [ -n "$REMOTE_HOST" ]; then
        ssh -o ConnectTimeout=5 "$REMOTE_HOST" "$@"
    else
        bash -c "$@"
    fi
}

# Get models in JSON format.
# When REMOTE_ENDPOINT is set, fetch from /v1/models HTTP API instead of
# running ramalama locally — avoids needing ramalama/podman on the client.
get_models_json() {
    if [ -n "$REMOTE_ENDPOINT" ]; then
        curl -s "${REMOTE_ENDPOINT}/v1/models" \
            | jq '[.data[] | {name: .id, size: 0}]'
    else
        run_cmd "ramalama list --json"
    fi
}

# Check if ramalama is running with the correct image.
# For the default model, also considers the quadlet systemd service.
is_ramalama_running() {
    # Remote endpoint: check liveness via HTTP health endpoint.
    if [ -n "$REMOTE_ENDPOINT" ]; then
        curl -sf "${REMOTE_ENDPOINT}/health" > /dev/null 2>&1
        return
    fi
    if [[ "$SELECTED_MODEL" == "$DEFAULT_MODEL" ]]; then
        systemctl --user is-active --quiet "$QUADLET_SERVICE" && return 0
    fi
    run_cmd "ramalama ps --noheading" | grep -q "${CONTAINER_NAME}"
}

# ---------------------------------------------------------------------------
# detect_gtt: read GTT total and available from sysfs (Strix Halo unified pool)
# Sets GTT_TOTAL_GB and GTT_AVAIL_GB globals.
# ---------------------------------------------------------------------------
detect_gtt() {
    GTT_TOTAL_GB=0
    GTT_AVAIL_GB=0
    for card in /sys/class/drm/card*/device; do
        # Use mem_info_vram_total — reflects the BIOS VRAM allocation (e.g. 96GB on Strix Halo).
        # mem_info_gtt_total only shows the GTT aperture (~15GB), NOT the full GPU pool.
        VRAM_TOTAL_PATH="${card}/mem_info_vram_total"
        VRAM_USED_PATH="${card}/mem_info_vram_used"
        if [[ -f "$VRAM_TOTAL_PATH" && -f "$VRAM_USED_PATH" ]]; then
            TOTAL_VRAM_BYTES=$(cat "$VRAM_TOTAL_PATH")
            USED_VRAM_BYTES=$(cat "$VRAM_USED_PATH")
            GTT_TOTAL_GB=$(( TOTAL_VRAM_BYTES / 1024 / 1024 / 1024 ))
            GTT_AVAIL_GB=$(( (TOTAL_VRAM_BYTES - USED_VRAM_BYTES) / 1024 / 1024 / 1024 ))
            return
        fi
    done
    # Fallback: use system RAM
    GTT_TOTAL_GB=$(free -g | awk '/^Mem:/{print $2}')
    GTT_AVAIL_GB=$(free -g | awk '/^Mem:/{print $7}')
}

# ---------------------------------------------------------------------------
# get_ramalama_endpoint: Returns the base endpoint URL, detecting actual port
# ---------------------------------------------------------------------------
get_ramalama_endpoint() {
    # Direct remote endpoint — use as-is.
    if [ -n "$REMOTE_ENDPOINT" ]; then
        echo "$REMOTE_ENDPOINT"
        return
    fi

    local host_base="http://${LOCAL_HOST}"
    local port="${LOCAL_PORT}"

    # If a container named $CONTAINER_NAME exists, try to get its mapped port
    if run_cmd "podman inspect --format='{{.State.Status}}' ${CONTAINER_NAME} 2>/dev/null" | grep -q 'running'; then
        local mapped_port
        mapped_port=$(run_cmd "podman port ${CONTAINER_NAME} 2>/dev/null" | grep -o ':[0-9]\+$' | head -n1 | tr -d ':')
        if [ -n "$mapped_port" ]; then
            port="$mapped_port"
        fi
    fi

    echo "${host_base}:${port}"
}

# ---------------------------------------------------------------------------
# check_resources: warn if available unified memory is less than required
# ---------------------------------------------------------------------------
check_resources() {
    local required_gb=$1
    [ -n "$REMOTE_HOST" ] && return     # skip for SSH remote
    [ -n "$REMOTE_ENDPOINT" ] && return # skip for direct HTTP remote

    detect_gtt
    local AVAIL_GTT=$GTT_AVAIL_GB

    if [ "$AVAIL_GTT" -lt "$required_gb" ]; then
        gum style --border normal --margin "1" --padding "1" --border-foreground 212 \
            "⚠️  LOW MEMORY DETECTED (Strix Halo Unified Pool)" \
            "Available: ${AVAIL_GTT}GB  |  Required for Model: ${required_gb}GB"

        if gum confirm "Do you want to kill some processes to free up RAM?"; then
            SELECTION=$(ps axo pid,pmem,comm --sort=-pmem | head -n 21 | tail -n +2 | \
                awk '{printf "%-7s | %-5s%% | %s\n", $1, $2, $3}' | \
                gum choose --header "Select processes to kill (Esc to skip)" --no-limit)

            if [ -n "$SELECTION" ]; then
                PIDS=$(echo "$SELECTION" | awk '{print $1}')
                for PID in $PIDS; do
                    gum spin --spinner dot --title "Killing process $PID..." -- sleep 0.5
                    kill -9 "$PID" 2>/dev/null && echo "✅ Killed $PID" || echo "❌ Failed to kill $PID"
                done
                check_resources "$required_gb"
            fi
        fi
    fi
}

# ---------------------------------------------------------------------------
# wait_for_server: poll until the /v1/models endpoint responds or timeout
# ---------------------------------------------------------------------------
wait_for_server() {
    local endpoint="${1}/v1/models"
    local max_wait=120
    local count=0

    gum style --foreground 212 "⏳ Waiting for RamaLama server at ${endpoint}..."

    while true; do
        HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" "${endpoint}" 2>/dev/null)
        if [[ "$HTTP_CODE" == "200" ]]; then
            gum style --foreground 121 "✅ RamaLama server is ready! (${count}s)"
            gum style --foreground 39 \
                "   🌐 Web UI → ${1}" \
                "   🔌 API    → ${1}/v1"
            return 0
        fi
        sleep 1
        (( count++ ))
        if [ "$count" -ge "$max_wait" ]; then
            gum style --foreground 196 "❌ RamaLama server did not respond after ${max_wait}s (last HTTP ${HTTP_CODE})."
            gum style --foreground 196 "   Check container logs: ramalama logs ${CONTAINER_NAME}"
            return 1
        fi
        # Show progress every 10 seconds
        if (( count % 10 == 0 )); then
            gum style --foreground 212 "   Still waiting... (${count}s / ${max_wait}s, HTTP ${HTTP_CODE})"
        fi
    done
}

# ---------------------------------------------------------------------------
# get_model_id_from_endpoint: derive a clean model id from the running server
# ---------------------------------------------------------------------------
get_model_id_from_endpoint() {
    local endpoint="${1}/v1/models"
    curl -s "${endpoint}" | jq -r '.data[0].id // empty' | \
        sed 's|^/mnt/models/||; s|\.gguf$||'
}

# ---------------------------------------------------------------------------
# configure_opencode: write the ramalama provider + model into opencode.json
# The opencode openai-compatible provider expects:
#   provider.<id>.models.<model-key> = { name: "..." }
#   model = "<provider-id>/<model-key>"
# The model-key must be exactly the model ID the server returns from /v1/models
# ---------------------------------------------------------------------------
configure_opencode() {
    local base_endpoint="$1"
    local model_id="$2"        # e.g. hf://unsloth/Qwen3-Coder-Next-GGUF:Q4_K_M
    local model_display="$3"   # human-friendly name

    [ -f "$OPENCODE_CONFIG" ] || return

    local base_url="${base_endpoint}/v1"
    # Legacy SSH remote: override with explicit host:port
    [ -n "$REMOTE_HOST" ] && base_url="http://${REMOTE_HOST}:${LOCAL_PORT}/v1"

    TEMP=$(mktemp --suffix=.json)

    jq \
        --arg key    "$model_id" \
        --arg name   "$model_display" \
        --arg base   "$base_url" \
        --arg full   "ramalama/${model_id}" \
        --argjson ctx "$CTX_SIZE" \
        '
        .model = $full |
        .provider.ramalama = {
          "name": "RamaLama (llama.cpp)",
          "npm":  "@ai-sdk/openai-compatible",
          "options": { "baseURL": $base },
          "models": {
            ($key): {
              "_launch": true,
              "name": $name,
              "limit": { "context": $ctx, "output": 8192 }
            }
          }
        }
        ' \
        "$OPENCODE_CONFIG" > "$TEMP" && mv "$TEMP" "$OPENCODE_CONFIG"

    gum style --foreground 121 "📝 OpenCode configured → provider: ramalama / model: ${model_id}"
}

# ---------------------------------------------------------------------------
# pick_model HEADER [models_json]
# Prints selected model name to stdout; returns 1 if user cancels.
# ---------------------------------------------------------------------------
pick_model() {
    local header="$1"
    local models_json="${2:-$(get_models_json)}"
    local models_with_size default_line other_lines selected_line

    models_with_size=$(echo "$models_json" | jq -r '.[] | "\(.name)  (\((.size//0)/1073741824|floor)GB)"')
    default_line=$(echo "$models_with_size" | grep -F "$DEFAULT_MODEL" | head -1)
    if [ -n "$default_line" ]; then
        other_lines=$(echo "$models_with_size" | grep -vF "$DEFAULT_MODEL")
        models_with_size=$(printf "%s\n%s" "$default_line" "$other_lines")
    fi
    selected_line=$(echo "$models_with_size" | gum choose --header "$header")
    [ -z "$selected_line" ] && return 1
    echo "$selected_line" | sed 's/  (.*//'
}

# ---------------------------------------------------------------------------
# ensure_server_running: start server if needed; handle model switch if already
# running. Sets globals: ENDPOINT, SELECTED_MODEL, SERVED_MODEL_ID, CTX_SIZE
# ---------------------------------------------------------------------------
ensure_server_running() {
    if [ -n "$REMOTE_ENDPOINT" ] && ! curl -sf "${REMOTE_ENDPOINT}/health" >/dev/null 2>&1; then
        gum style --foreground 196 "❌ Cannot reach ramalama at ${REMOTE_ENDPOINT} — is the server running and reachable?"
        exit 1
    fi

    if ! is_ramalama_running; then
        if [ -n "$REMOTE_ENDPOINT" ]; then
            echo "❌ Remote endpoint ${REMOTE_ENDPOINT} not healthy." && exit 1
        fi
        if run_cmd "ramalama ps --noheading" | grep -q "${CONTAINER_NAME}"; then
            gum style --foreground 212 "🔄 Restarting RamaLama with optimized Strix Halo toolbox..."
            run_cmd "ramalama stop ${CONTAINER_NAME}"
            sleep 2
        fi

        # Model selection
        local models_json model_names
        models_json=$(get_models_json)
        model_names=$(echo "$models_json" | jq -r '.[].name // empty')

        if [ -z "$model_names" ]; then
            echo "❌ No RamaLama models found on $([ -n "$REMOTE_HOST" ] && echo "$REMOTE_HOST" || echo "local system")."
            if command -v llmfit &>/dev/null; then
                if $DRY_RUN || gum confirm "Run llmfit to find & pull a recommended model?"; then
                    cmd_search
                fi
            fi
            exit 1
        fi

        if [ -n "$CLI_MODEL" ]; then
            if echo "$model_names" | grep -qF "$CLI_MODEL"; then
                SELECTED_MODEL="$CLI_MODEL"
            else
                echo "❌ Model not found in ramalama list: $CLI_MODEL"
                echo "Available models:"
                echo "$model_names" | sed 's/^/  /'
                exit 1
            fi
        else
            SELECTED_MODEL=$(pick_model "Select a model to serve  [default: gemma-4-31B-it Q4_K_M]" "$models_json") || exit 1
        fi

        local model_size_bytes model_size_gb required_gb
        model_size_bytes=$(echo "$models_json" | jq -r --arg n "$SELECTED_MODEL" '.[] | select(.name == $n) | .size')
        model_size_gb=$(( ${model_size_bytes:-0} / 1024 / 1024 / 1024 ))
        required_gb=$(( model_size_gb + 4 ))

        CTX_SIZE=$(get_ctx_size "$SELECTED_MODEL")
        echo "📐 Context window for ${SELECTED_MODEL}: ${CTX_SIZE} tokens"

        detect_gtt

        if [ "$model_size_gb" -gt "$GTT_TOTAL_GB" ] && [ "$GTT_TOTAL_GB" -gt 0 ]; then
            gum style --border double --border-foreground 196 --margin "1" --padding "1" \
                "🚫 MODEL TOO LARGE FOR GPU POOL" \
                "Model size:       ${model_size_gb}GB" \
                "GPU pool (GTT):   ${GTT_TOTAL_GB}GB  (${GTT_AVAIL_GB}GB free)" \
                "This model will NOT load. Select a smaller model or increase VRAM in BIOS."

            if command -v llmfit &>/dev/null && gum confirm "Show llmfit-recommended models that DO fit?"; then
                cmd_search
            fi
            exit 1
        fi

        check_resources "$required_gb"

        echo "�� Starting RamaLama with ${SELECTED_MODEL}..."
        if [[ "$SELECTED_MODEL" == "$DEFAULT_MODEL" ]] && systemctl --user list-unit-files --quiet "$QUADLET_SERVICE" &>/dev/null; then
            dry_run_cmd "systemctl --user start '${QUADLET_SERVICE}'"
        else
            local image_flag=""
            [ -n "$USE_IMAGE" ] && image_flag="--image ${USE_IMAGE}"
            dry_run_cmd "run_cmd 'ramalama serve --detach --name ${CONTAINER_NAME} ${image_flag} -c ${CTX_SIZE} --runtime-args=\"${EXTRA_SERVE_FLAGS}\" ${SELECTED_MODEL}'"
        fi

        sleep 2
        ENDPOINT=$(get_ramalama_endpoint)

        if [ -n "$REMOTE_HOST" ]; then
            local remote_port
            remote_port=$(echo "$ENDPOINT" | grep -o ':[0-9]\+$' | tr -d ':')
            echo "ℹ️  Ensure port ${remote_port} is accessible from ${REMOTE_HOST}"
            ENDPOINT="http://${REMOTE_HOST}:${remote_port}"
        fi

        if ! $DRY_RUN && ! wait_for_server "$ENDPOINT"; then
            echo "❌ Aborting — server failed to start."
            exit 1
        fi

        if $DRY_RUN; then
            SERVED_MODEL_ID="$SELECTED_MODEL"
        else
            SERVED_MODEL_ID=$(get_model_id_from_endpoint "$ENDPOINT")
            [ -z "$SERVED_MODEL_ID" ] && SERVED_MODEL_ID="$SELECTED_MODEL"
        fi
    else
        # Already running — detect the live model then decide whether to switch.
        ENDPOINT=$(get_ramalama_endpoint)

        if ! $DRY_RUN; then
            local running_model
            running_model=$(get_model_id_from_endpoint "$ENDPOINT")
            if [ -z "$running_model" ]; then
                local container_model
                container_model=$(podman inspect --format='{{.Args}}' ${CONTAINER_NAME} 2>/dev/null | grep -o 'hf://[^ ]*' | tr -d ']')
                running_model="${container_model:-unknown-model}"
            fi
            echo "✅ RamaLama already running with: ${running_model} on ${ENDPOINT}"

            # Determine desired model (flag or interactive picker)
            local desired_model
            if [ -n "$CLI_MODEL" ]; then
                desired_model="$CLI_MODEL"
            else
                local models_json
                models_json=$(get_models_json)
                desired_model=$(pick_model "Running: ${running_model} — keep or switch?  [default: gemma-4-31B-it Q4_K_M]" "$models_json") || exit 0
            fi

            if [[ "$desired_model" != "$running_model" ]]; then
                gum style --foreground 212 "🔄 Switching model: ${running_model} → ${desired_model}"
                if systemctl --user is-active --quiet "$QUADLET_SERVICE" 2>/dev/null; then
                    dry_run_cmd "systemctl --user stop '${QUADLET_SERVICE}'"
                else
                    dry_run_cmd "ramalama stop '${CONTAINER_NAME}'"
                fi
                sleep 2

                SELECTED_MODEL="$desired_model"
                CTX_SIZE=$(get_ctx_size "$SELECTED_MODEL")
                echo "📐 Context window for ${SELECTED_MODEL}: ${CTX_SIZE} tokens"
                detect_gtt

                local switch_models_json switch_size_bytes switch_size_gb switch_required_gb
                switch_models_json=$(get_models_json)
                switch_size_bytes=$(echo "$switch_models_json" | jq -r --arg n "$SELECTED_MODEL" '.[] | select(.name == $n) | .size // 0')
                switch_size_gb=$(( ${switch_size_bytes:-0} / 1024 / 1024 / 1024 ))
                switch_required_gb=$(( switch_size_gb + 4 ))
                check_resources "$switch_required_gb"

                echo "🚀 Starting RamaLama with ${SELECTED_MODEL}..."
                if [[ "$SELECTED_MODEL" == "$DEFAULT_MODEL" ]] && systemctl --user list-unit-files --quiet "$QUADLET_SERVICE" &>/dev/null; then
                    dry_run_cmd "systemctl --user start '${QUADLET_SERVICE}'"
                else
                    local image_flag=""
                    [ -n "$USE_IMAGE" ] && image_flag="--image ${USE_IMAGE}"
                    dry_run_cmd "run_cmd 'ramalama serve --detach --name ${CONTAINER_NAME} ${image_flag} -c ${CTX_SIZE} --runtime-args=\"${EXTRA_SERVE_FLAGS}\" ${SELECTED_MODEL}'"
                fi
                sleep 2
                ENDPOINT=$(get_ramalama_endpoint)
                if ! $DRY_RUN && ! wait_for_server "$ENDPOINT"; then
                    echo "❌ Aborting — server failed to start after switch."
                    exit 1
                fi
            else
                SELECTED_MODEL="$running_model"
            fi

            SERVED_MODEL_ID=$(get_model_id_from_endpoint "$ENDPOINT")
            [ -z "$SERVED_MODEL_ID" ] && SERVED_MODEL_ID="$SELECTED_MODEL"
        else
            SERVED_MODEL_ID="${CLI_MODEL:-dry-run-model}"
            SELECTED_MODEL="$SERVED_MODEL_ID"
        fi
        CTX_SIZE=$(get_ctx_size "$SELECTED_MODEL")
    fi
}

# ============================================================================
# SUBCOMMAND FUNCTIONS
# ============================================================================

cmd_list() {
    local models_json
    models_json=$(get_models_json)
    if [ -z "$models_json" ] || [ "$models_json" = "[]" ]; then
        echo "No models found. Run: oramalama pull"
        return
    fi
    local header="NAME\tSIZE\tCONTEXT\tMODIFIED"
    local rows
    rows=$(echo "$models_json" | jq -r '.[] |
        [
            .name,
            ((.size // 0) / 1073741824 | floor | tostring) + "GB",
            "",
            (.modified // "—")
        ] | @tsv')
    local table_data="$header"
    while IFS=$'\t' read -r name size _ctx modified; do
        local ctx
        ctx=$(get_ctx_size "$name")
        local display_name="$name"
        [[ "$name" == "$DEFAULT_MODEL" ]] && display_name="★ $name"
        table_data+=$'\n'"${display_name}\t${size}\t${ctx}\t${modified}"
    done <<< "$rows"
    echo "$table_data" | gum table
}

cmd_ps() {
    if [ -n "$REMOTE_ENDPOINT" ]; then
        if curl -sf "${REMOTE_ENDPOINT}/health" >/dev/null 2>&1; then
            local model
            model=$(curl -s "${REMOTE_ENDPOINT}/v1/models" | jq -r '[.data[].id] | join(", ")' 2>/dev/null)
            echo "NAME\tENDPOINT\tSTATUS" | gum table
            printf "%s\t%s\t%s\n" "$model" "$REMOTE_ENDPOINT" "running" | gum table
        else
            echo "No server running at ${REMOTE_ENDPOINT}"
        fi
        return
    fi
    local ps_out
    ps_out=$(ramalama ps --noheading 2>/dev/null)
    if [ -z "$ps_out" ]; then
        echo "No models currently running."
        return
    fi
    local endpoint
    endpoint=$(get_ramalama_endpoint)
    echo "NAME\tMODEL\tENDPOINT" | gum table
    echo "$ps_out" | while read -r line; do
        local cname model
        cname=$(echo "$line" | awk '{print $NF}')
        model=$(podman inspect --format='{{index .Config.Cmd}}' "$cname" 2>/dev/null | grep -o 'hf://[^ ]*\|/mnt/models/[^ ]*' | head -1)
        printf "%s\t%s\t%s\n" "$cname" "${model:-unknown}" "$endpoint"
    done | gum table
}

cmd_pull() {
    local model="${1:-}"
    if [ -z "$model" ] && [ -n "$CLI_MODEL" ]; then
        model="$CLI_MODEL"
    fi
    if [ -z "$model" ]; then
        cmd_search
        return
    fi
    echo "📥 Pulling ${model}..."
    if $DRY_RUN; then
        echo "[dry-run] ramalama pull ${model}"
        return
    fi
    ramalama pull "$model" && \
        gum style --foreground 121 "✅ Pulled ${model}" || \
        gum style --foreground 196 "❌ Pull failed"
}

cmd_rm() {
    local model="${1:-$CLI_MODEL}"
    if [ -z "$model" ]; then
        local models_json
        models_json=$(get_models_json)
        local selected
        selected=$(echo "$models_json" | jq -r '.[] | "\(.name)  (\((.size//0)/1073741824|floor)GB)"' \
            | gum choose --header "Select model to remove")
        [ -z "$selected" ] && return
        model=$(echo "$selected" | sed 's/  (.*//')
    fi
    gum confirm "Remove ${model}?" || return
    dry_run_cmd "ramalama rm '${model}'" && \
        gum style --foreground 121 "✅ Removed ${model}"
}

cmd_stop() {
    if [ -n "$REMOTE_ENDPOINT" ]; then
        echo "ℹ️  Cannot stop a remote server from here. Use the remote machine."
        return
    fi

    if systemctl --user is-active --quiet "$QUADLET_SERVICE" 2>/dev/null; then
        gum confirm "Stop ${QUADLET_SERVICE}?" || return
        dry_run_cmd "systemctl --user stop '${QUADLET_SERVICE}'"
        gum style --foreground 121 "✅ Stopped ${QUADLET_SERVICE}"
        return
    fi

    local running
    running=$(ramalama ps --noheading 2>/dev/null)
    if [ -z "$running" ]; then
        echo "No models currently running."
        return
    fi

    local container
    if [ -n "${1:-}" ]; then
        container="$1"
    else
        container=$(echo "$running" | awk '{print $NF}' \
            | gum choose --header "Select container to stop")
        [ -z "$container" ] && return
    fi

    gum confirm "Stop ${container}?" || return
    dry_run_cmd "ramalama stop '${container}'"
    gum style --foreground 121 "✅ Stopped ${container}"
}

cmd_show() {
    local model="${1:-$CLI_MODEL}"

    if [ -z "$model" ]; then
        local models_json
        models_json=$(get_models_json)
        model=$(pick_model "Select a model to inspect" "$models_json") || exit 0
    fi

    local models_json size_bytes size_gb ctx quant arch tags
    models_json=$(get_models_json)
    size_bytes=$(echo "$models_json" | jq -r --arg n "$model" '.[] | select(.name == $n) | .size // 0')
    size_gb=$(( ${size_bytes:-0} / 1024 / 1024 / 1024 ))
    ctx=$(get_ctx_size "$model")

    # Quant from trailing :Qx_x or :Ix tag
    quant=$(echo "$model" | grep -oE ':[QqIi][0-9][^:/ ]*' | tr -d ':' | head -1)
    [ -z "$quant" ] && quant="—"

    # Architecture from name keywords
    if   echo "$model" | grep -qi "gemma";    then arch="Gemma"
    elif echo "$model" | grep -qi "qwen";     then arch="Qwen"
    elif echo "$model" | grep -qi "llama";    then arch="Llama"
    elif echo "$model" | grep -qi "mistral";  then arch="Mistral"
    elif echo "$model" | grep -qi "phi";      then arch="Phi"
    elif echo "$model" | grep -qi "deepseek"; then arch="DeepSeek"
    elif echo "$model" | grep -qi "falcon";   then arch="Falcon"
    elif echo "$model" | grep -qi "wizard";   then arch="WizardLM"
    else arch="—"
    fi

    [[ "$model" == "$DEFAULT_MODEL" ]] && tags=" ★ default" || tags=""

    gum style \
        --border rounded \
        --padding "1 3" \
        --border-foreground 212 \
        "$(gum style --bold --foreground 212 "$model")${tags}" \
        "" \
        "$(printf "  %-14s %s" "Architecture:"  "$arch")" \
        "$(printf "  %-14s %s" "Quantization:"  "$quant")" \
        "$(printf "  %-14s %s GB" "Size:"        "$size_gb")" \
        "$(printf "  %-14s %s tokens" "Context:"  "$ctx")"

    # Show endpoint if this model is currently being served
    if is_ramalama_running 2>/dev/null; then
        local ep running_id
        ep=$(get_ramalama_endpoint)
        running_id=$(get_model_id_from_endpoint "$ep" 2>/dev/null)
        local model_base
        model_base=$(basename "$model" | sed 's/:.*//')
        if [[ "$running_id" == *"$model_base"* ]] || [[ "$model" == *"$running_id"* ]]; then
            gum style --foreground 121 "  🟢 Running → ${ep}"
        fi
    fi
}

cmd_run() {
    local THINK=false HIDETHINKING=false VERBOSE=false
    local model="${CLI_MODEL:-}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --think)        THINK=true;        shift ;;
            --hidethinking) HIDETHINKING=true; shift ;;
            --verbose)      VERBOSE=true;      shift ;;
            --*)            echo "Unknown flag: $1"; usage ;;
            *)              model="$1"; shift ;;
        esac
    done

    if [ -z "$model" ]; then
        local models_json model_names
        models_json=$(get_models_json)
        model_names=$(echo "$models_json" | jq -r '.[].name // empty')
        if [ -z "$model_names" ]; then
            echo "No models found. Run: oramalama pull"
            exit 1
        fi
        model=$(pick_model "Select a model to chat with" "$models_json") || exit 0
    fi

    if $DRY_RUN; then
        local flags=""
        $THINK        && flags+=" --think"
        $HIDETHINKING && flags+=" --hidethinking"
        $VERBOSE      && flags+=" --verbose"
        echo "[dry-run] oramalama run${flags} ${model}"
        return
    fi

    # Start server (sets ENDPOINT, SERVED_MODEL_ID, CTX_SIZE)
    CLI_MODEL="$model"
    ensure_server_running

    # ── Session state ────────────────────────────────────────────────────────
    local msgs_file params_file
    msgs_file=$(mktemp --suffix=.json)
    params_file=$(mktemp --suffix=.json)
    echo "[]" > "$msgs_file"
    echo "{}"  > "$params_file"
    local system_prompt="" in_think=false
    trap 'rm -f "$msgs_file" "$params_file"' EXIT INT TERM

    gum style \
        --border normal --padding "0 1" --border-foreground 212 \
        "$(gum style --bold --foreground 212 "oramalama run") ─ ${SERVED_MODEL_ID}" \
        "Slash commands: /help   Exit: /bye or Ctrl-C"

    # ── REPL loop ────────────────────────────────────────────────────────────
    while true; do
        local user_input
        read -e -r -p $'\033[38;5;212m>>> \033[0m' user_input || break
        [ -z "$user_input" ] && continue
        history -s "$user_input"

        # ── Slash commands ────────────────────────────────────────────────────
        case "$user_input" in
            /bye|/quit|/exit) break ;;

            /help)
                cat <<'HELP'
  /set system <text>       Set the system prompt  (/set system  to clear)
  /set parameter <k> <v>  Set a generation param  (temperature, top_p, …)
  /clear                  Wipe conversation history
  /save <name>            Save session to ~/.config/oramalama/sessions/<name>
  /load <name>            Load a saved session
  /show                   Print current model, system prompt, params
  /bye                    Exit
HELP
                continue ;;

            /clear)
                echo "[]" > "$msgs_file"
                echo "{}"  > "$params_file"
                system_prompt="" in_think=false
                echo "🗑️  Cleared."
                continue ;;

            "/set system")
                system_prompt=""
                echo "✅ System prompt cleared."
                continue ;;
            "/set system "*)
                system_prompt="${user_input#/set system }"
                echo "✅ System prompt set."
                continue ;;

            "/set parameter "*)
                local kv="${user_input#/set parameter }"
                local pk="${kv%% *}" pv="${kv#* }"
                local tmp_p; tmp_p=$(mktemp --suffix=.json)
                jq --arg k "$pk" \
                   --argjson v "$(jq -rn --arg v "$pv" '$v | tonumber? // .' 2>/dev/null || echo "\"$pv\"")" \
                   '.[$k] = $v' "$params_file" > "$tmp_p" \
                    && mv "$tmp_p" "$params_file" \
                    || echo "⚠️  Could not parse value: ${pv}"
                echo "✅ ${pk} = ${pv}"
                continue ;;

            "/save "*)
                local sname="${user_input#/save }"
                local sdir="$HOME/.config/oramalama/sessions"
                mkdir -p "$sdir"
                cp "$msgs_file" "${sdir}/${sname}.json"
                echo "💾 Saved → ${sdir}/${sname}.json"
                continue ;;

            "/load "*)
                local lname="${user_input#/load }"
                local lfile="$HOME/.config/oramalama/sessions/${lname}.json"
                if [ -f "$lfile" ]; then
                    cp "$lfile" "$msgs_file"
                    in_think=false
                    echo "📂 Loaded ${lname}."
                else
                    echo "❌ Not found: ${lfile}"
                fi
                continue ;;

            /show)
                echo "Model   : ${SERVED_MODEL_ID}"
                echo "Context : ${CTX_SIZE} tokens"
                echo "Endpoint: ${ENDPOINT}"
                echo "System  : ${system_prompt:-<none>}"
                echo "Params  : $(cat "$params_file")"
                continue ;;
        esac

        # ── Build request ────────────────────────────────────────────────────
        local messages
        messages=$(cat "$msgs_file")
        messages=$(jq --arg c "$user_input" '. + [{"role":"user","content":$c}]' <<< "$messages")

        local request
        request=$(jq -n \
            --arg     model   "$SERVED_MODEL_ID" \
            --argjson msgs    "$messages" \
            --argjson params  "$(cat "$params_file")" \
            --argjson think   "$THINK" \
            '$params + {model: $model, stream: true, messages: $msgs} |
             if $think then . + {thinking: true} else . end')
        if [ -n "$system_prompt" ]; then
            request=$(jq --arg sys "$system_prompt" \
                '.messages = [{"role":"system","content":$sys}] + .messages' <<< "$request")
        fi

        # ── Stream response ──────────────────────────────────────────────────
        local full_response="" tok_per_sec="" prompt_n="" predicted_n=""
        in_think=false
        printf '\n'

        while IFS= read -r sse_line; do
            [[ "$sse_line" == "data: [DONE]" ]] && break
            [[ "$sse_line" != "data: "* ]]      && continue
            local chunk="${sse_line#data: }"

            # Reasoning/thinking delta (Gemma 4 / DeepSeek-R1 reasoning_content field)
            local rdelta
            rdelta=$(jq -r '.choices[0].delta.reasoning_content // empty' <<< "$chunk" 2>/dev/null)
            if [ -n "$rdelta" ] && ! $HIDETHINKING; then
                printf '\033[2m%s\033[0m' "$rdelta"
            fi

            # Content delta — also handles inline <think>…</think> blocks
            local cdelta
            cdelta=$(jq -r '.choices[0].delta.content // empty' <<< "$chunk" 2>/dev/null)
            if [ -n "$cdelta" ]; then
                if $HIDETHINKING; then
                    # State-machine: strip <think>…</think> that may span chunks
                    local rest="$cdelta"
                    while [ -n "$rest" ]; do
                        if $in_think; then
                            if [[ "$rest" == *"</think>"* ]]; then
                                in_think=false
                                rest="${rest#*</think>}"
                            else
                                rest=""
                            fi
                        else
                            if [[ "$rest" == *"<think>"* ]]; then
                                local visible="${rest%%<think>*}"
                                printf '%s' "$visible"
                                full_response+="$visible"
                                in_think=true
                                rest="${rest#*<think>}"
                            else
                                printf '%s' "$rest"
                                full_response+="$rest"
                                rest=""
                            fi
                        fi
                    done
                else
                    printf '%s' "$cdelta"
                    full_response+="$cdelta"
                fi
            fi

            # Timings are in the final (finish_reason) chunk
            local raw_tps
            raw_tps=$(jq -r '.timings.predicted_per_second // empty' <<< "$chunk" 2>/dev/null)
            if [ -n "$raw_tps" ]; then
                tok_per_sec="$raw_tps"
                prompt_n=$(jq -r    '.timings.prompt_n    // 0' <<< "$chunk" 2>/dev/null)
                predicted_n=$(jq -r '.timings.predicted_n // 0' <<< "$chunk" 2>/dev/null)
            fi
        done < <(curl -sN \
            -H "Content-Type: application/json" \
            -d "$request" \
            "${ENDPOINT}/v1/chat/completions" 2>/dev/null)

        printf '\n'
        if $VERBOSE && [ -n "$tok_per_sec" ]; then
            printf '\033[2m📊 %.1f tok/s  ·  %s prompt tokens  ·  %s generated\033[0m\n' \
                "$tok_per_sec" "$prompt_n" "$predicted_n"
        fi
        printf '\n'

        # Append assistant turn to history
        messages=$(jq --arg c "$full_response" '. + [{"role":"assistant","content":$c}]' <<< "$messages")
        echo "$messages" > "$msgs_file"
    done

    rm -f "$msgs_file" "$params_file"
}

cmd_serve() {
    local model="${1:-$CLI_MODEL}"

    if [ -n "$REMOTE_ENDPOINT" ]; then
        echo "ℹ️  Using remote server at ${REMOTE_ENDPOINT}"
        get_ramalama_endpoint
        return
    fi

    if [ -z "$model" ]; then
        local models_json model_names
        models_json=$(get_models_json)
        model_names=$(echo "$models_json" | jq -r '.[].name // empty')
        if [ -z "$model_names" ]; then
            echo "❌ No models found. Run: oramalama pull"
            exit 1
        fi
        model=$(pick_model "Select a model to serve" "$models_json") || exit 0
    fi

    SELECTED_MODEL="$model"
    local ctx
    ctx=$(get_ctx_size "$SELECTED_MODEL")
    CTX_SIZE="$ctx"
    echo "📐 Context window: ${CTX_SIZE} tokens"

    local models_json model_size_bytes model_size_gb required_gb
    models_json=$(get_models_json)
    model_size_bytes=$(echo "$models_json" | jq -r --arg n "$SELECTED_MODEL" '.[] | select(.name==$n) | .size // 0')
    model_size_gb=$(( ${model_size_bytes:-0} / 1024 / 1024 / 1024 ))
    required_gb=$(( model_size_gb + 4 ))
    detect_gtt
    if [ "$model_size_gb" -gt "$GTT_TOTAL_GB" ] && [ "$GTT_TOTAL_GB" -gt 0 ]; then
        gum style --border double --border-foreground 196 --margin "1" --padding "1" \
            "🚫 MODEL TOO LARGE" \
            "Model: ${model_size_gb}GB  GPU pool: ${GTT_TOTAL_GB}GB"
        exit 1
    fi
    check_resources "$required_gb"

    echo "🚀 Starting server with ${SELECTED_MODEL}..."
    if [[ "$SELECTED_MODEL" == "$DEFAULT_MODEL" ]] && systemctl --user list-unit-files --quiet "$QUADLET_SERVICE" &>/dev/null; then
        dry_run_cmd "systemctl --user start '${QUADLET_SERVICE}'"
    else
        local image_flag=""
        [ -n "$USE_IMAGE" ] && image_flag="--image ${USE_IMAGE}"
        dry_run_cmd "run_cmd 'ramalama serve --detach --name ${CONTAINER_NAME} ${image_flag} -c ${CTX_SIZE} --runtime-args=\"${EXTRA_SERVE_FLAGS}\" ${SELECTED_MODEL}'"
    fi
    sleep 2

    local endpoint
    endpoint=$(get_ramalama_endpoint)
    if ! $DRY_RUN && ! wait_for_server "$endpoint"; then
        echo "❌ Server failed to start."
        exit 1
    fi
    echo "🟢 Server ready"
    gum style --foreground 39 \
        "   🌐 Web UI → ${endpoint}" \
        "   🔌 API    → ${endpoint}/v1"
    ENDPOINT="$endpoint"
}

cmd_search() {
    if ! command -v llmfit &>/dev/null; then
        gum style --foreground 196 \
            "⚠️  llmfit is not installed. Install it for model recommendations:" \
            "    https://github.com/jmorganca/llmfit"
        return 1
    fi

    # Read actual GTT total from sysfs — reflects BIOS VRAM allocation (e.g. 96GB)
    # This is more accurate than system RAM which the OS sees after BIOS split.
    detect_gtt
    local MEM_FLAG="${GTT_TOTAL_GB}G"
    gum style --foreground 212 "🤖 Querying llmfit for hardware-optimal models (Strix Halo, ${GTT_TOTAL_GB}GB GPU pool)..."

    local LLMFIT_JSON
    LLMFIT_JSON=$(llmfit \
        --memory "${MEM_FLAG}" \
        recommend \
        --use-case coding \
        --min-fit good \
        -n 8 \
        --json 2>/dev/null)

    if [ -z "$LLMFIT_JSON" ]; then
        gum style --foreground 196 "⚠️  llmfit did not return results."
        return
    fi

    # Build a human-readable list: "name (Xgb, ~Y tok/s) [best_quant]"
    local SUGGESTIONS
    SUGGESTIONS=$(echo "$LLMFIT_JSON" | jq -r '
        .models[] |
        "\(.name)  (\(.memory_required_gb | floor)GB, ~\(.estimated_tps | floor) tok/s, \(.best_quant))"
    ')

    gum style --bold "💡 llmfit recommendations for your hardware:"
    echo "$SUGGESTIONS" | gum style --foreground 105

    if gum confirm "Would you like to pull one of these recommended models via ramalama?"; then
        local SELECTED_LINE
        SELECTED_LINE=$(echo "$SUGGESTIONS" | gum choose --header "Select a model to pull")
        [ -z "$SELECTED_LINE" ] && return

        # Extract original name (before the parenthetical suffix)
        local SELECTED_LLMFIT_NAME
        SELECTED_LLMFIT_NAME=$(echo "$SELECTED_LINE" | sed 's/  (.*//')

        # Find best_quant for this model
        local BEST_QUANT
        BEST_QUANT=$(echo "$LLMFIT_JSON" | jq -r \
            --arg n "$SELECTED_LLMFIT_NAME" \
            '.models[] | select(.name == $n) | .best_quant')

        # Find a gguf_source repo (prefer unsloth or bartowski)
        local GGUF_REPO
        GGUF_REPO=$(echo "$LLMFIT_JSON" | jq -r \
            --arg n "$SELECTED_LLMFIT_NAME" \
            '.models[] | select(.name == $n) | .gguf_sources[]
             | select(.provider == "unsloth" or .provider == "bartowski")
             | .repo' | head -1)

        local PULL_REF
        if [ -n "$GGUF_REPO" ]; then
            PULL_REF="hf://${GGUF_REPO}:${BEST_QUANT}"
        else
            # No known GGUF — try huggingface generic path
            PULL_REF="hf://${SELECTED_LLMFIT_NAME}:${BEST_QUANT}"
        fi

        gum style --foreground 212 "📥 Pulling ${PULL_REF} via ramalama..."
        run_cmd "ramalama pull ${PULL_REF}" && \
            gum style --foreground 121 "✅ Model pulled! Restart the script to use it." || \
            gum style --foreground 196 "❌ Pull failed. Check ramalama pull output above."
        exit 0
    fi
}

# Backward-compat alias
suggest_models_llmfit() { cmd_search; }

# ---------------------------------------------------------------------------
# launch_open_webui: start Open WebUI container pointed at our API then open
# a browser tab. Containers can't reach 127.0.0.1 on the host directly, so
# we rewrite the host part to host.containers.internal (podman/docker).
# ---------------------------------------------------------------------------
launch_open_webui() {
    local api_base="$1"
    local port="${OPEN_WEBUI_PORT:-3000}"
    local cname="open-webui-oramalama"
    local engine
    engine=$(command -v podman 2>/dev/null || command -v docker 2>/dev/null || true)
    if [ -z "$engine" ]; then
        gum style --foreground 196 "❌ podman or docker is required to run Open WebUI"
        return 1
    fi

    # Rewrite localhost to the container-accessible host gateway
    local container_api="${api_base//127.0.0.1/host.containers.internal}"
    container_api="${container_api//localhost/host.containers.internal}"

    if "$engine" ps --format '{{.Names}}' 2>/dev/null | grep -qx "$cname"; then
        gum style --foreground 121 "✅ Open WebUI already running → http://localhost:${port}"
    else
        gum style --foreground 212 "🐋 Starting Open WebUI container (ghcr.io/open-webui/open-webui:main)..."
        dry_run_cmd "$engine run -d --rm \
            --name '${cname}' \
            -p ${port}:8080 \
            -e OPENAI_API_BASE_URL='${container_api}/v1' \
            -e OPENAI_API_KEY='sk-no-key-required' \
            ghcr.io/open-webui/open-webui:main"
        $DRY_RUN || gum spin --spinner dot --title "Waiting for Open WebUI to start..." -- sleep 6
    fi

    gum style --foreground 39 "🌐 Open WebUI → http://localhost:${port}"
    dry_run_cmd "xdg-open 'http://localhost:${port}'"
}

cmd_launch() {
    local launch_tool=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tool)    launch_tool="$2"; shift 2 ;;
            --suggest) cmd_search; return ;;
            *)         break ;;
        esac
    done

    # Merge with DEFAULT_TOOL from config, then CLI_TOOL from global flags
    [ -z "$launch_tool" ] && launch_tool="${DEFAULT_TOOL:-}"
    [ -z "$launch_tool" ] && launch_tool="${CLI_TOOL:-}"

    # Tool selection
    local SELECTED_TOOL
    if [ -n "$launch_tool" ]; then
        case "${launch_tool,,}" in
            opencode)                   SELECTED_TOOL="OpenCode" ;;
            goose)                      SELECTED_TOOL="Goose CLI" ;;
            aichat)                     SELECTED_TOOL="aichat" ;;
            webui|web-ui|web_ui)        SELECTED_TOOL="Web UI" ;;
            open-webui|openwebui)       SELECTED_TOOL="Open WebUI" ;;
            server|only*)               SELECTED_TOOL="Only Start Server" ;;
            suggest|llmfit)             cmd_search; return ;;
            *)                          echo "❌ Unknown tool: $launch_tool"; usage ;;
        esac
    else
        # Build tool list dynamically — only show tools that are installed
        local TOOLS=()
        # ── Coding tools ──────────────────────────────────────────────────────
        command -v opencode &>/dev/null && TOOLS+=("OpenCode")
        TOOLS+=("Goose CLI")
        command -v aichat   &>/dev/null && TOOLS+=("aichat")
        # ── Web UIs ───────────────────────────────────────────────────────────
        # llama.cpp built-in webui is always available (same port as API, root path)
        TOOLS+=("Web UI  (llama.cpp built-in)")
        { command -v podman &>/dev/null || command -v docker &>/dev/null; } \
            && TOOLS+=("Open WebUI  (container, port ${OPEN_WEBUI_PORT:-3000})")
        # ── Utilities ─────────────────────────────────────────────────────────
        TOOLS+=("Only Start Server")
        command -v llmfit &>/dev/null && TOOLS+=("Suggest Models (llmfit)")

        SELECTED_TOOL=$(printf "%s\n" "${TOOLS[@]}" \
            | gum choose --header "Select a tool  [coding · web ui · utilities]")
        [ -z "$SELECTED_TOOL" ] && exit 0
    fi

    if [ "$SELECTED_TOOL" = "Suggest Models (llmfit)" ]; then
        cmd_search
        return
    fi

    # Start or reuse the server (sets ENDPOINT, SELECTED_MODEL, SERVED_MODEL_ID, CTX_SIZE)
    ensure_server_running

    # Tool execution
    case "$SELECTED_TOOL" in
        "OpenCode")
            local DISPLAY_NAME
            DISPLAY_NAME=$(echo "$SERVED_MODEL_ID" | sed 's|hf://||; s|:| |g; s|/| / |g')
            configure_opencode "$ENDPOINT" "$SERVED_MODEL_ID" "$DISPLAY_NAME (RamaLama)"
            gum style --foreground 212 "💻 Launching OpenCode..."
            dry_run_cmd "opencode $*"
            ;;
        "Goose CLI")
            gum style --foreground 212 "🦢 Launching Goose CLI..."
            dry_run_cmd "GOOSE_PROVIDER=openai GOOSE_MODEL=${SERVED_MODEL_ID} OPENAI_HOST=${ENDPOINT} OPENAI_API_KEY=sk-no-key-required goose session"
            ;;
        "aichat")
            gum style --foreground 212 "💬 Launching aichat..."
            dry_run_cmd "OPENAI_API_BASE='${ENDPOINT}/v1' OPENAI_API_KEY='sk-no-key-required' aichat"
            ;;
        "Web UI"*)
            gum style --foreground 212 "🌐 Opening llama.cpp Web UI..."
            gum style --foreground 39 "   ${ENDPOINT}"
            dry_run_cmd "xdg-open '${ENDPOINT}'"
            return  # server keeps running; no cleanup needed
            ;;
        "Open WebUI"*)
            launch_open_webui "$ENDPOINT"
            return  # server keeps running; Open WebUI container manages its own lifecycle
            ;;
        "Only Start Server")
            gum style --foreground 121 \
                "✅ Server ready" \
                "   🌐 Web UI → ${ENDPOINT}" \
                "   🔌 API    → ${ENDPOINT}/v1"
            return
            ;;
    esac

    # Cleanup: stop server when last tool instance exits (local only).
    # Skip if the container is managed by systemd — let the service keep running.
    # Skip entirely if we're pointed at a remote endpoint.
    if [ -z "$REMOTE_HOST" ] && [ -z "$REMOTE_ENDPOINT" ]; then
        sleep 1
        if ! pgrep -f "bin/opencode|goose|claude|copilot|aichat" > /dev/null; then
            if systemctl --user is-active --quiet "$QUADLET_SERVICE" 2>/dev/null; then
                echo "💤 Last instance closed. Leaving systemd service running (use: systemctl --user stop ${QUADLET_SERVICE})"
            else
                echo "💤 Last instance closed. Stopping RamaLama..."
                dry_run_cmd "ramalama stop '${CONTAINER_NAME}'"
            fi
        fi
    fi
}

# ============================================================================
# usage
# ============================================================================
usage() {
    cat <<EOF
Usage: oramalama [--remote <url>] [--model <name>] [--dry-run] <subcommand> [args]

Subcommands:
  run [model]        Interactive chat REPL (starts server if needed)
                       --think          Show model reasoning/thinking
                       --hidethinking   Hide <think> blocks from output
                       --verbose        Print tok/s stats after each reply
  serve [model]      Start the inference server (detached)
  launch             Start server + launch a tool
                       --tool opencode    AI coding (OpenCode)
                       --tool goose       AI coding (Goose CLI)
                       --tool aichat      Terminal chat (aichat)
                       --tool webui       llama.cpp built-in Web UI (browser)
                       --tool open-webui  Full chat UI via podman container
  list               List downloaded models
  pull [model]       Pull a model (suggests best fit if no model given)
  ps                 Show running models
  stop [container]   Stop the running server or a specific container
  show [model]       Show model metadata (arch, quant, size, context)
  rm [model]         Remove a model
  search             Search and recommend models via llmfit

Global flags:
  --remote <url>     Use a remote ramalama server (e.g. http://myserver:8080)
  --model <name>     Model to use (skips interactive picker)
  --dry-run          Print actions without executing them

Config: ~/.config/oramalama/config (bash key=value)
  RAMALAMA_ENDPOINT  Same as --remote
  DEFAULT_MODEL      Override default model
  DEFAULT_TOOL       Pre-select tool for launch (opencode, goose)
EOF
    exit 0
}

# ============================================================================
# GLOBAL FLAG PARSING + SUBCOMMAND DISPATCH
# ============================================================================

SUBCOMMAND="launch"   # default
DRY_RUN=false
CLI_MODEL=""
CLI_TOOL=""
REMOTE_ENDPOINT="${RAMALAMA_ENDPOINT:-}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --remote)   RAMALAMA_ENDPOINT="$2"; REMOTE_ENDPOINT="$2"; shift 2 ;;
        --dry-run)  DRY_RUN=true; shift ;;
        --model)    CLI_MODEL="$2"; shift 2 ;;
        --help|-h)  usage ;;
        --)         shift; break ;;
        -*)         echo "Unknown flag: $1"; usage ;;
        *)          SUBCOMMAND="$1"; shift; break ;;
    esac
done

[[ "$SUBCOMMAND" =~ ^(help|--help)$ ]] || check_deps
[ -z "$REMOTE_ENDPOINT" ] && detect_hardware

case "$SUBCOMMAND" in
    run)          cmd_run "$@" ;;
    serve)        cmd_serve "$@" ;;
    launch)       cmd_launch "$@" ;;
    list|ls)      cmd_list "$@" ;;
    pull)         cmd_pull "$@" ;;
    ps)           cmd_ps "$@" ;;
    stop)         cmd_stop "$@" ;;
    show)         cmd_show "$@" ;;
    rm)           cmd_rm "$@" ;;
    search)       cmd_search "$@" ;;
    help|--help)  usage ;;
    *)            echo "❌ Unknown subcommand: $SUBCOMMAND"; usage ;;
esac
